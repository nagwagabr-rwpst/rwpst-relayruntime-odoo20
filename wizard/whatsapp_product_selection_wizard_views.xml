<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_whatsapp_product_selection_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.product.selection.wizard.form</field>
        <field name="model">whatsapp.product.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Product Selection">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="campaign_id" readonly="1"/>
                            <field name="log_id" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="notes" placeholder="Customer selection notes..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Selected Products" name="lines">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_sale_order"
                        string="Create Sale Order"
                        type="object"
                        class="btn-primary"/>
                    <button name="action_cancel"
                        string="Cancel"
                        type="object"
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
